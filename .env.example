# =============================================================================
# Production Full-Stack SaaS Starter — Environment Variables
# Copy this file to .env and fill in values for local development.
# Never commit real credentials.
# =============================================================================

# --- Runtime ---
NODE_ENV=development

# --- API server ---
# Railway injects PORT automatically. Use 4000 locally.
PORT=4000
API_HOST=0.0.0.0

# --- PostgreSQL (required) ---
# Local (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_starter?schema=public
# Railway: use a reference variable, e.g.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Redis (optional for basic API startup; recommended in production) ---
# Local (docker-compose):
REDIS_URL=redis://localhost:6379
# Railway: use a reference variable, e.g.
# REDIS_URL=${{Redis.REDIS_URL}}

# --- Authentication ---
# Generate a strong secret, e.g. openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
# Public URL of the API used by the browser
NEXT_PUBLIC_API_URL=http://localhost:4000

# Next.js server port (local)
WEB_PORT=3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# --- Seed (optional) ---
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=DemoPassword123!
SEED_USER_NAME=Demo User
