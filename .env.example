# =============================================================================
# Production Full-Stack SaaS Starter — Environment Variables
# Copy this file to .env for local development only.
# Never commit real credentials.
# =============================================================================

# --- Runtime ---
NODE_ENV=development

# --- API server ---
# Railway injects PORT automatically in deployed services.
PORT=4000
API_HOST=0.0.0.0

# --- PostgreSQL (required) ---
# Local (docker-compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_starter?schema=public
#
# Railway Template / Template Composer (private networking):
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Redis (optional for basic API startup; recommended on Railway) ---
# Local (docker-compose):
REDIS_URL=redis://localhost:6379
#
# Railway Template / Template Composer (private networking):
# REDIS_URL=${{Redis.REDIS_URL}}

# --- Authentication ---
# LOCAL ONLY placeholder — replace via `npm run setup` or your own secret.
# On Railway Marketplace templates use an auto-generated value:
# JWT_SECRET=${{secret(64)}}
# Do NOT deploy with this placeholder value.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Local:
CORS_ORIGIN=http://localhost:3000
#
# Railway (public web origin; include https://):
# CORS_ORIGIN=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# --- Frontend (Next.js) ---
# Browser-reachable API base URL (must be available at Next.js build time).
# Local:
NEXT_PUBLIC_API_URL=http://localhost:4000
#
# Railway (public API origin; include https:// — do not hardcode a domain):
# NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# --- Demo seed (LOCAL / DEMO ONLY — not used by Railway deploy) ---
# npm run db:seed refuses to run in production unless ALLOW_PROD_SEED=true.
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=DemoPassword123!
SEED_USER_NAME=Demo User
# ALLOW_PROD_SEED=true
