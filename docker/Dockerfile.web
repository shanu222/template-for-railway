# Multi-stage production image for the Next.js web service.
# Build context: repository root

FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json* ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/config/package.json ./packages/config/package.json
RUN npm install --workspace=@app/web --workspace=@repo/shared --include-workspace-root --ignore-scripts

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
# NEXT_PUBLIC_* must be present at build time for the browser bundle.
# On Railway, set NEXT_PUBLIC_API_URL as a service variable so it is
# available during the Docker build (do not hardcode a Railway domain).
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN if [ -z "$NEXT_PUBLIC_API_URL" ]; then \
      echo "WARNING: NEXT_PUBLIC_API_URL is empty at build time. Set it before building for production."; \
    fi
RUN npm run build -w @repo/shared
RUN npm run build -w @app/web

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nodejs \
  && adduser -S nextjs -G nodejs

COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./apps/web/.next/static

USER nextjs
EXPOSE 3000
# Railway injects PORT at runtime; do not hardcode a production domain.
CMD ["node", "apps/web/server.js"]
